# START-DOCKER.cmd creates .env with random secrets automatically.
APP_PORT=3000
MYSQL_PASSWORD=replace-with-a-random-app-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional direct Node connection to a separately installed MySQL server:
DB_CLIENT=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=village_portal
MYSQL_USER=village
HOST=127.0.0.1
PORT=3000
SEED_DEMO=true
NODE_ENV=development
